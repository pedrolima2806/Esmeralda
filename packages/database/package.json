{
  "name": "@esmeralda/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "node --env-file=../../.env node_modules/prisma/build/index.js generate",
    "migrate:dev": "node --env-file=../../.env node_modules/prisma/build/index.js migrate dev",
    "migrate:deploy": "node --env-file=../../.env node_modules/prisma/build/index.js migrate deploy",
    "studio": "node --env-file=../../.env node_modules/prisma/build/index.js studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.12.0"
  },
  "devDependencies": {
    "prisma": "6.12.0",
    "typescript": "5.9.3"
  }
}

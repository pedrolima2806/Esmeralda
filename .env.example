# Local PostgreSQL started by infrastructure/docker/compose.yml
DATABASE_URL="postgresql://esmeralda:esmeralda_dev@localhost:5433/esmeralda?schema=public"

# Server-side application settings
APP_URL="http://localhost:3000"
LOG_LEVEL="INFO"

# Optional: expands the assets and limits available through brapi.dev
BRAPI_TOKEN=""

# Local administrative access (replace every value outside local development)
ADMIN_EMAIL="admin@esmeralda.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"
